{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_:-]*$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "unlockLevel": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 40
      },
      "unlockCost": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "rarity": {
        "type": "string",
        "enum": [
          "common",
          "rare",
          "epic",
          "legendary",
          "prestige"
        ]
      },
      "tier": {
        "type": "string",
        "enum": [
          "standard",
          "rare",
          "legendary"
        ]
      },
      "artBrief": {
        "type": "string",
        "minLength": 1
      },
      "color": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      },
      "metalness": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "roughness": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "emissive": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      },
      "emissiveIntensity": {
        "type": "number",
        "minimum": 0
      },
      "prestige": {
        "type": "string",
        "enum": [
          "cosmic",
          "toxic"
        ]
      },
      "shopCurrency": {
        "type": "string",
        "enum": [
          "credits",
          "career"
        ]
      }
    },
    "required": [
      "id",
      "name",
      "unlockLevel",
      "unlockCost",
      "rarity",
      "tier",
      "artBrief",
      "color",
      "metalness",
      "roughness"
    ],
    "additionalProperties": false
  },
  "title": "Vanguard Ops weapon-skins catalog"
}
