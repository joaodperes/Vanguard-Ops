{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_:-]*$"
      },
      "weaponId": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_:-]*$"
      },
      "skinId": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_:-]*$"
      },
      "goal": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "metric": {
        "type": "string",
        "enum": [
          "kills",
          "headshots",
          "bare_kills",
          "fully_equipped_kills",
          "ads_kills",
          "hipfire_kills",
          "airborne_kills",
          "close_range_kills",
          "long_range_kills",
          "multikill_kills",
          "suppressed_kills",
          "critical_health_kills",
          "comeback_kills"
        ]
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string",
        "minLength": 1
      },
      "requirements": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "metric": {
              "type": "string",
              "enum": [
                "kills",
                "headshots",
                "bare_kills",
                "fully_equipped_kills",
                "ads_kills",
                "hipfire_kills",
                "airborne_kills",
                "close_range_kills",
                "long_range_kills",
                "multikill_kills",
                "suppressed_kills",
                "critical_health_kills",
                "comeback_kills"
              ]
            },
            "goal": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "metric",
            "goal"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "id",
      "weaponId",
      "skinId",
      "goal",
      "metric",
      "title",
      "description"
    ],
    "additionalProperties": false
  },
  "title": "Vanguard Ops weapon-challenges catalog"
}
