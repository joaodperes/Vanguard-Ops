{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Map blueprints",
  "type": "object",
  "required": [
    "version",
    "units",
    "maps"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "units": {
      "type": "string"
    },
    "maps": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_:-]*$": {
          "type": "object",
          "required": [
            "name",
            "shortName",
            "description",
            "pace",
            "regions",
            "features",
            "spawns"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "shortName": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "pace": {
              "enum": [
                "compact",
                "balanced",
                "tactical"
              ]
            },
            "templateMapId": {
              "type": "string"
            },
            "regions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "x",
                  "z",
                  "w",
                  "d"
                ],
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  },
                  "w": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "d": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "shape": {
                    "enum": [
                      "rect",
                      "circle",
                      "triangle"
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "features": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "x",
                  "z",
                  "w",
                  "d",
                  "h",
                  "kind"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_:-]*$"
                  },
                  "x": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  },
                  "w": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "d": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "h": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "kind": {
                    "enum": [
                      "cover",
                      "platform",
                      "accent",
                      "stairs"
                    ]
                  },
                  "label": {
                    "type": "string"
                  },
                  "axis": {
                    "enum": [
                      "x",
                      "z"
                    ]
                  },
                  "sign": {
                    "enum": [
                      -1,
                      1
                    ]
                  },
                  "autoStairs": {
                    "type": "boolean"
                  },
                  "y": {
                    "type": "number"
                  },
                  "turns": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3
                  }
                },
                "additionalProperties": false
              }
            },
            "spawns": {
              "type": "object",
              "required": [
                "ffa",
                "red",
                "blue"
              ],
              "properties": {
                "ffa": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number"
                    }
                  }
                },
                "red": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number"
                    }
                  }
                },
                "blue": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number"
                    }
                  }
                }
              },
              "additionalProperties": false
            },
            "hazards": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "x",
                  "z",
                  "y",
                  "w",
                  "d",
                  "h"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_:-]*$"
                  },
                  "type": {
                    "enum": [
                      "fire",
                      "spikes",
                      "jump_pad",
                      "moving_platform",
                      "destructible_wall"
                    ]
                  },
                  "x": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "w": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "d": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "h": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "dps": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "damage": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "period": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "activeFor": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "hp": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "offset": {
                    "type": "number"
                  },
                  "launchX": {
                    "type": "number"
                  },
                  "launchY": {
                    "type": "number"
                  },
                  "launchZ": {
                    "type": "number"
                  },
                  "toX": {
                    "type": "number"
                  },
                  "toY": {
                    "type": "number"
                  },
                  "toZ": {
                    "type": "number"
                  },
                  "turns": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3
                  }
                },
                "additionalProperties": false
              }
            },
            "legacyCoverOverrides": {
              "type": "object",
              "patternProperties": {
                "^(0|[1-9][0-9]*)$": {
                  "type": "object",
                  "required": [
                    "x",
                    "y",
                    "z",
                    "w",
                    "h",
                    "d"
                  ],
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "z": {
                      "type": "number"
                    },
                    "w": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "h": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "d": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "turns": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 3
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "legacyEnvironmentOverrides": {
              "type": "object",
              "patternProperties": {
                "^(0|[1-9][0-9]*)$": {
                  "type": "object",
                  "required": [
                    "x",
                    "y",
                    "z",
                    "w",
                    "h",
                    "d"
                  ],
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "z": {
                      "type": "number"
                    },
                    "w": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "h": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "d": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "turns": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 3
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "legacyCoverDisabled": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "legacyEnvironmentDisabled": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "cityBuildingDisabled": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^city:-?[0-9]+:-?[0-9]+$"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
