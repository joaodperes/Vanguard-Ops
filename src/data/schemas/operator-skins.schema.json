{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operator skins",
  "description": "Catalog authored in Vanguard Ops. Run bun run content:validate for cross-catalog checks.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "unlockLevel",
      "unlockCost",
      "rarity",
      "color",
      "accent"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_:-]*$"
      },
      "name": {
        "type": "string"
      },
      "unlockLevel": {
        "type": "integer",
        "minimum": 1,
        "maximum": 40
      },
      "unlockCost": {
        "type": "integer",
        "minimum": 0
      },
      "rarity": {
        "enum": [
          "common",
          "rare",
          "epic",
          "legendary"
        ]
      },
      "color": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      },
      "accent": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      },
      "emissive": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      },
      "levelReward": {
        "type": "boolean",
        "description": "Account-level milestone reward; automatically owned at this level without a contract or purchase."
      }
    },
    "additionalProperties": false
  }
}
