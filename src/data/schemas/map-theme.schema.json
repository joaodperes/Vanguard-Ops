{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "biome": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "inheritPropsFrom": {
      "type": "string",
      "minLength": 1
    },
    "palette": {
      "type": "object",
      "properties": {
        "floor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "wall": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "cover": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "platform": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "stair": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "sky": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "fog": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "grid": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "floor",
        "wall",
        "cover",
        "accent",
        "platform",
        "stair",
        "sky",
        "fog",
        "grid"
      ],
      "additionalProperties": false
    },
    "ambient": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "vegetation": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "tree",
              "bush",
              "rock",
              "ruin",
              "temple",
              "shop",
              "lamp",
              "container",
              "crane",
              "terminal",
              "sign",
              "antenna",
              "building",
              "boat",
              "dock",
              "garden",
              "bench",
              "bandstand",
              "sarcophagus",
              "furnace",
              "conveyor",
              "hydraulic_press",
              "generator",
              "storage_rack",
              "vent_stack",
              "industrial_pipe",
              "steel_coil",
              "cargo_pallet"
            ]
          },
          "x": {
            "type": "number"
          },
          "z": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "w": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "d": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "h": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "use": {
            "type": "string",
            "enum": [
              "house",
              "cafe",
              "supermarket",
              "bakery",
              "apartments",
              "office",
              "hotel",
              "library",
              "diner",
              "clinic",
              "workshop",
              "gallery",
              "florist",
              "gym"
            ]
          },
          "shape": {
            "type": "string",
            "enum": [
              "rect",
              "narrow",
              "round"
            ]
          },
          "stairSide": {
            "type": "string",
            "enum": [
              "east",
              "west"
            ]
          },
          "roofAccess": {
            "type": "boolean"
          },
          "facade": {
            "type": "string",
            "enum": [
              "brick",
              "stucco",
              "concrete",
              "glass",
              "timber",
              "industrial"
            ]
          },
          "lotId": {
            "type": "string",
            "pattern": "^city:-?[0-9]+:-?[0-9]+$"
          },
          "turns": {
            "anyOf": [
              {
                "type": "number",
                "const": 0
              },
              {
                "type": "number",
                "const": 1
              },
              {
                "type": "number",
                "const": 2
              },
              {
                "type": "number",
                "const": 3
              }
            ]
          }
        },
        "required": [
          "kind",
          "x",
          "z"
        ],
        "additionalProperties": false
      }
    },
    "surfaces": {
      "type": "object",
      "properties": {
        "floor": {
          "type": "object",
          "properties": {
            "pattern": {
              "type": "string",
              "enum": [
                "concrete",
                "metal",
                "grate",
                "planks",
                "rust",
                "moss",
                "brick",
                "stone",
                "pavers",
                "snow",
                "asphalt",
                "grass"
              ]
            },
            "tileSize": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "roughness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "textureId": {
              "type": "string",
              "enum": [
                "kenney_01",
                "kenney_04",
                "kenney_06",
                "kenney_08",
                "kenney_10",
                "kenney_13"
              ]
            }
          },
          "required": [
            "pattern",
            "tileSize",
            "roughness"
          ],
          "additionalProperties": false
        },
        "wall": {
          "type": "object",
          "properties": {
            "pattern": {
              "type": "string",
              "enum": [
                "concrete",
                "metal",
                "grate",
                "planks",
                "rust",
                "moss",
                "brick",
                "stone",
                "pavers",
                "snow",
                "asphalt",
                "grass"
              ]
            },
            "tileSize": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "roughness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "textureId": {
              "type": "string",
              "enum": [
                "kenney_01",
                "kenney_04",
                "kenney_06",
                "kenney_08",
                "kenney_10",
                "kenney_13"
              ]
            }
          },
          "required": [
            "pattern",
            "tileSize",
            "roughness"
          ],
          "additionalProperties": false
        },
        "cover": {
          "type": "object",
          "properties": {
            "pattern": {
              "type": "string",
              "enum": [
                "concrete",
                "metal",
                "grate",
                "planks",
                "rust",
                "moss",
                "brick",
                "stone",
                "pavers",
                "snow",
                "asphalt",
                "grass"
              ]
            },
            "tileSize": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "roughness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "textureId": {
              "type": "string",
              "enum": [
                "kenney_01",
                "kenney_04",
                "kenney_06",
                "kenney_08",
                "kenney_10",
                "kenney_13"
              ]
            }
          },
          "required": [
            "pattern",
            "tileSize",
            "roughness"
          ],
          "additionalProperties": false
        },
        "stair": {
          "type": "object",
          "properties": {
            "pattern": {
              "type": "string",
              "enum": [
                "concrete",
                "metal",
                "grate",
                "planks",
                "rust",
                "moss",
                "brick",
                "stone",
                "pavers",
                "snow",
                "asphalt",
                "grass"
              ]
            },
            "tileSize": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "roughness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "textureId": {
              "type": "string",
              "enum": [
                "kenney_01",
                "kenney_04",
                "kenney_06",
                "kenney_08",
                "kenney_10",
                "kenney_13"
              ]
            }
          },
          "required": [
            "pattern",
            "tileSize",
            "roughness"
          ],
          "additionalProperties": false
        },
        "platform": {
          "type": "object",
          "properties": {
            "pattern": {
              "type": "string",
              "enum": [
                "concrete",
                "metal",
                "grate",
                "planks",
                "rust",
                "moss",
                "brick",
                "stone",
                "pavers",
                "snow",
                "asphalt",
                "grass"
              ]
            },
            "tileSize": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "roughness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "textureId": {
              "type": "string",
              "enum": [
                "kenney_01",
                "kenney_04",
                "kenney_06",
                "kenney_08",
                "kenney_10",
                "kenney_13"
              ]
            }
          },
          "required": [
            "pattern",
            "tileSize",
            "roughness"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "floor",
        "wall",
        "cover",
        "stair",
        "platform"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "biome",
    "label",
    "palette",
    "ambient",
    "vegetation",
    "props"
  ],
  "additionalProperties": false,
  "title": "Vanguard Ops biome theme"
}
