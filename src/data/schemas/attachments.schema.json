{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_:-]*$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string",
        "minLength": 1
      },
      "slot": {
        "type": "string",
        "enum": [
          "sight",
          "barrel",
          "grip",
          "magazine"
        ]
      },
      "unlockLevel": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 40
      },
      "unlockCost": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "exclusiveWeaponIds": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_:-]*$"
        }
      },
      "weaponCategories": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "assault",
            "smg",
            "shotgun",
            "dmr",
            "sniper",
            "lmg",
            "pistol",
            "pdw",
            "launcher",
            "melee"
          ]
        }
      },
      "recommendedFor": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "assault",
            "smg",
            "shotgun",
            "dmr",
            "sniper",
            "lmg",
            "pistol",
            "pdw",
            "launcher",
            "melee"
          ]
        }
      },
      "sightType": {
        "type": "string",
        "enum": [
          "iron",
          "red_dot",
          "holo",
          "acog",
          "hunter",
          "thermal",
          "nvg",
          "laser",
          "sniper_scope"
        ]
      },
      "shotgunAmmo": {
        "type": "string",
        "enum": [
          "slug",
          "pellets",
          "dragons_breath",
          "beanbag"
        ]
      },
      "bodyPenetration": {
        "type": "object",
        "properties": {
          "maxTargets": {
            "type": "integer",
            "minimum": 2,
            "maximum": 3
          },
          "damageRetention": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "retentionBonus": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "maxTargets",
          "damageRetention"
        ],
        "additionalProperties": false
      },
      "effects": {
        "type": "object",
        "properties": {
          "damage": {
            "type": "number"
          },
          "recoil": {
            "type": "number"
          },
          "spread": {
            "type": "number"
          },
          "adsSpread": {
            "type": "number"
          },
          "adsTime": {
            "type": "number"
          },
          "magSize": {
            "type": "number"
          },
          "fireRate": {
            "type": "number"
          },
          "reloadTime": {
            "type": "number"
          },
          "moveSpeed": {
            "type": "number"
          },
          "range": {
            "type": "number"
          }
        },
        "additionalProperties": false
      },
      "heatOnly": {
        "type": "boolean"
      },
      "categoryEffects": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "damage": {
              "type": "number"
            },
            "recoil": {
              "type": "number"
            },
            "spread": {
              "type": "number"
            },
            "adsSpread": {
              "type": "number"
            },
            "adsTime": {
              "type": "number"
            },
            "magSize": {
              "type": "number"
            },
            "fireRate": {
              "type": "number"
            },
            "reloadTime": {
              "type": "number"
            },
            "moveSpeed": {
              "type": "number"
            },
            "range": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      },
      "weaponEffects": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "damage": {
              "type": "number"
            },
            "recoil": {
              "type": "number"
            },
            "spread": {
              "type": "number"
            },
            "adsSpread": {
              "type": "number"
            },
            "adsTime": {
              "type": "number"
            },
            "magSize": {
              "type": "number"
            },
            "fireRate": {
              "type": "number"
            },
            "reloadTime": {
              "type": "number"
            },
            "moveSpeed": {
              "type": "number"
            },
            "range": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      },
      "heatEffects": {
        "type": "object",
        "properties": {
          "heatPerShot": {
            "type": "number"
          },
          "coolPerSecond": {
            "type": "number"
          },
          "coolDelayMs": {
            "type": "number"
          },
          "ventSeconds": {
            "type": "number"
          },
          "overheatAt": {
            "type": "number"
          },
          "resumeAt": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "required": [
      "id",
      "name",
      "description",
      "slot",
      "unlockLevel",
      "unlockCost",
      "effects"
    ],
    "additionalProperties": false
  },
  "title": "Vanguard Ops attachments catalog"
}
